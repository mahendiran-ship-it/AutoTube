# Copy this file to ".env" and fill in only what you need.
# Every value here is OPTIONAL. The default workflow needs no API keys.
# NEVER commit your real .env file (it is in .gitignore).

# --- Local AI -------------------------------------------------------------
# Ollama server (default shown). Leave unset to use the default.
# OLLAMA_HOST=http://localhost:11434
# Optional key for an OpenAI-compatible endpoint (llama.cpp server, LM Studio...)
# Most local servers need no key.
# LLM_API_KEY=

# --- Free stock media (free keys, sign-up required) -----------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# NASA Image and Video Library needs no key.

# --- Local image generation (optional) ------------------------------------
# AUTOMATIC1111 / Forge started with --api. Enable in config/settings.yaml
# SD_WEBUI_URL=http://127.0.0.1:7860

# --- YouTube (Google Cloud OAuth) -----------------------------------------
# Path to the OAuth "Desktop app" client JSON you download from Google Cloud.
YOUTUBE_CLIENT_SECRETS=data/secrets/client_secret.json

# --- Dashboard ------------------------------------------------------------
# Required only if you bind the dashboard to something other than localhost.
# DASHBOARD_TOKEN=change-me-to-a-long-random-string

# --- Notifications (optional) ---------------------------------------------
# Generic JSON webhook (Discord/Slack-compatible incoming webhook URL)
# NOTIFY_WEBHOOK_URL=

# --- Misc -----------------------------------------------------------------
# Contact string sent in the User-Agent to feeds / Wikimedia (be polite).
AUTOTUBE_CONTACT=
# Override project root (rarely needed)
# AUTOTUBE_HOME=
